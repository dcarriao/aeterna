.st-key-ae_people_presentes_panel {
    position: relative;
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(212,168,79,0.18);
    border-radius: 14px;
    padding: 1.05rem 1.15rem 0.95rem;
