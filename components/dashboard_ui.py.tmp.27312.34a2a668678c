}

.st-key-ae_people_presentes_panel [data-testid="stButton"] button {
    min-height: 2.32rem !important;
    border-radius: 999px !important;
    background: rgba(255,248,231,0.92) !important;
    border: 1px solid rgba(242,181,16,0.45) !important;
    color: #9A5A00 !important;
    font-size: 0.84rem !important;
    font-weight: 950 !important;
    padding: 0.28rem 0.7rem !important;
    box-shadow: none !important;
    white-space: nowrap !important;
}

.ae-invites-panel {
    background: rgba(255,255,255,0.80);
    border: 1px solid rgba(212,168,79,0.18);
    border-radius: 14px;
    padding: 0.8rem 0.9rem 0.9rem;
    margin: 0.45rem 0 0.7rem;
    box-shadow: 0 12px 30px rgba(43,23,71,0.055);
}

.ae-invites-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
}

.ae-invite-row {
    display: grid;
    grid-template-columns: 44px 1fr auto 20px;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgba(212,168,79,0.18);
    border-radius: 10px;
    padding: 0.55rem 0.65rem;
    background: rgba(255,255,255,0.72);
}

.ae-invite-avatar {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: rgba(104,72,164,0.14);
