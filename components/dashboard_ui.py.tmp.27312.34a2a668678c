}

.ae-story-media {
    height: 86px;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle at 72% 18%, rgba(212,168,79,0.26), transparent 32%),
        linear-gradient(135deg, rgba(43,23,71,0.94), rgba(85,54,110,0.86));
    color: white;
}

.ae-story-media img {
    width: 100%;
    height: 100%;
